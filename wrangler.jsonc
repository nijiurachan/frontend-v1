{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend-v1",
  "compatibility_date": "2026-04-03",
  "upload_source_maps": true,
  "main": "src/worker.ts",
  "vars": {
    "PUBLIC_SITE_URL": "https://nijiurachan.net"
  },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "nijiurachan.net/manifest.json",
      "zone_name": "nijiurachan.net"
    },
    {
      "pattern": "nijiurachan.net/ts",
      "zone_name": "nijiurachan.net"
    },
    {
      "pattern": "nijiurachan.net/ts/*",
      "zone_name": "nijiurachan.net"
    },
    {
      "pattern": "nijiurachan.net/assets/klecks/*",
      "zone_name": "nijiurachan.net"
    },
    {
      "pattern": "nijiurachan.net/robots.txt",
      "zone_name": "nijiurachan.net"
    },
    {
      "pattern": "nijiurachan.net/sitemap.xml",
      "zone_name": "nijiurachan.net"
    }
  ],
  "env": {
    "dev": {},
    // 実験ビルドは別Worker (frontend-v1-test) + /ts-test パスで配信する
    // (mode=testing ビルド)。本番Worker (frontend-v1) には main ブランチの
    // build:prod だけを deploy する。
    "test": {
      "assets": {
        "directory": "./dist/",
        "not_found_handling": "single-page-application"
      },
      "routes": [
        {
          "pattern": "nijiurachan.net/ts-test",
          "zone_name": "nijiurachan.net"
        },
        {
          "pattern": "nijiurachan.net/ts-test/*",
          "zone_name": "nijiurachan.net"
        },
        {
          "pattern": "dev.nijiurachan.net/ts-test",
          "zone_name": "nijiurachan.net"
        },
        {
          "pattern": "dev.nijiurachan.net/ts-test/*",
          "zone_name": "nijiurachan.net"
        }
        // test.nijiurachan.net は nginx (Origin_Server:3000) がルート直下で
        // 配信する (VITE_BASE_PATH="" ビルド)。Worker ルートは張らない。
      ]
    }
  },
  "dev": {
    "enable_containers": false,
    "local_protocol": "https"
  }
}
