{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend-v1",
  "compatibility_date": "2026-04-03",
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": {},
    "test": {}
  },
  "dev": {
    "enable_containers": false,
    "local_protocol": "https"
  }
}
